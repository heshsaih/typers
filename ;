import { useEffect, useState, type FC } from "react";
import { Container } from "../../components/container";
import { useWords } from "../../hooks/use-words";
import { Spinner } from "../../components/spinner";
import { TextContainer } from "./text-container";
import { ConfigurationBar, type ConfigParams } from "./configuration-bar";
import { Button } from "../../components/button";
import { useTypingLogic } from "../../hooks/use-typing-logic";
import { ProgressCounter } from "./progress-counter";

export const TypingPage: FC = () => {
    const { getWords, words } = useWords();
    const [config, setConfig] = useState<ConfigParams>({
        gameType: "time",
        amount: 30,
    });
    const [timer, setTimer] = useState<number>(config.amount);

    useEffect(() => {
        if (config.gameType === "time") {
            setTimer(config.amount);
        }
    }, [config]);

    const { mappedWords, handleKeyboardClick, cursorPos } = useTypingLogic(words);

    const [isPlaying, setIsPlaying] = useState<boolean>(false);
    const [finished, setFinished] = useState<boolean>(false);

    const startLoop = () => {
        setIsPlaying(true);
        setFinished(false);
    };

    const finish = () => {
        setIsPlaying(false);
        setFinished(true);
    };

    useEffect(() => { }, []);

    const progress = () => {
        if (!isPlaying) {
            return `${config.amount} ${config.gameType === "words" ? "words" : "seconds"}`;
        } else {
            if (config.gameType === "words") {
                if (config.amount - cursorPos.w < 0) {
                    finish();
                }
                return config.amount - cursorPos.w;
            } else {
                if (timer === 0) {
                    finish();
                }
                return timer;
            }
        }
    };

    const callGetWords = () =>
        getWords({
            amount:
                config.gameType === "words"
                    ? config.amount
                    : 400 * (config.amount / 60),
        });

    useEffect(() => {
        callGetWords();
    }, [config]);

    return (
        <Container className="">
            {words ? (
                <>
                    <ProgressCounter>{progress()}</ProgressCounter>
                    <ConfigurationBar
                        isPlaying={isPlaying}
                        config={config}
                        setConfig={setConfig}
                    ></ConfigurationBar>
                    {finished ? (
                        <></>
                    ) : (
                        <TextContainer
                            startLoop={startLoop}
                            mappedWords={mappedWords}
                            cursorPos={cursorPos}
                            handleKeyboardClick={handleKeyboardClick}
                        ></TextContainer>
                    )}
                    <Button onClick={callGetWords}>Restart</Button>
                </>
            ) : (
                <Spinner></Spinner>
            )}
        </Container>
    );
};
